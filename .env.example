# Copy to .env.local for local development:
#   cp .env.example .env.local
# Never commit real keys.

# Required for Micro data (sidebar → Micro mode)
MICRO_API_KEY=
MICRO_TEAM_ID=

# Optional Micro configuration
# Leave unset for production keys (SDK default: https://developers.micro.so).
# Staging keys (created on staging.micro.so) need:
# MICRO_BASE_URL=https://developers.staging.micro.so
MICRO_BASE_URL=
# Your email — used for calendar “mine” filtering and Granola attendee exclusion.
# Leave empty to skip personal filtering.
MICRO_ME_EMAIL=

# Optional Granola integration
GRANOLA_API_KEY=

# Optional local demo fixtures (defaults under .local/ if unset)
LOCAL_EMAIL_ACTIVITY_PATH=
LOCAL_IMESSAGE_ACTIVITY_PATH=
